PREFIX snvoc: <http://solidbench-server:3000/www.ldbc.eu/ldbc_socialnet/1.0/vocabulary/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX ldp: <http://www.w3.org/ns/ldp#>

CONSTRUCT {
  ?message rdf:type snvoc:Post .
  ?message snvoc:content ?messageContent .
}

WHERE {
  # We assume the resource being requested ($identifier$) IS the creator (the Profile/Card)
  # OR that $identifier$ is the subject we want to filter by.
  
  ?message rdf:type snvoc:Post ;
}